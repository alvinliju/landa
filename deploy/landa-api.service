[Unit]
Description=landa control plane API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/landa
Environment=NODE_ENV=production
Environment=LANDA_ROOT=/var/lib/landa
Environment=LANDA_DATA=/var/lib/landa/.data
Environment=PGDATA=/var/lib/landa/.data/pg
Environment=PGHOST=127.0.0.1
Environment=PGPORT=5433
Environment=PGUSER=landa
Environment=PGPASSWORD=landa
Environment=PGDATABASE=landa
Environment=DATABASE_URL=postgres://landa:landa@127.0.0.1:5433/landa
# nginx proxies from landa.tharavad.xyz → this
Environment=LANDA_API_HOST=127.0.0.1
Environment=LANDA_API_PORT=8787
Environment=PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/var/lib/landa/node_modules/.bin
ExecStartPre=/run/current-system/sw/bin/env PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin bash -c 'cd /var/lib/landa && nix --extra-experimental-features "nix-command flakes" develop -c landa-pg start'
ExecStart=/run/current-system/sw/bin/env PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin bash -c 'cd /var/lib/landa && exec nix --extra-experimental-features "nix-command flakes" develop -c npm run api'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
